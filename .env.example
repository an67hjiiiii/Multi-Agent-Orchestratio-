APP_NAME=Local Multi-Agent RAG
APP_ENV=development
APP_DATA_DIR=./data
RUNS_DIR=./runs
IMPLEMENTATION_PROFILE=m0
PROVIDER=fake
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen3:4b
LOCAL_LLM_TIMEOUT_SECONDS=180
LOCAL_LLM_TEMPERATURE=0.1
TASK_TOP_K=6
PLANNING_TOP_K=3
MAX_CONTEXT_TOKENS=3000
MAX_OUTPUT_TOKENS=700
MAX_RUN_TOKENS=12000
RETRY_LIMIT=1
MIN_RETRIEVAL_SCORE=0.18
